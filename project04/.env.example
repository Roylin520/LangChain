# 複製成 .env 後修改；.env 已被 .gitignore 排除
APP_NAME=Notes Hub

# 正式環境務必換成隨機字串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# JWT 有效期（分鐘），預設 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 資料庫；換 Postgres 時改成 postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/notes.db

# 單一檔案上傳上限（bytes）
MAX_UPLOAD_BYTES=5242880

# 一次 sync push 的筆數上限
MAX_SYNC_BATCH=200

# 是否開放註冊
ALLOW_REGISTRATION=true
